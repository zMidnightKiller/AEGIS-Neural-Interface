# --- AI MODELS ---
ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here # Usado para Whisper e Embeddings

# --- TOOLS ---
TAVILY_API_KEY=your_key_here

# --- SERVICES ---
REDIS_URL=redis://localhost:6379
CHROMA_PERSIST_DIR=./data/chroma
NEO4J_URI=bolt://localhost:7687
NEO4J_PASSWORD=password

# --- AEGIS CONFIG ---
AEGIS_MODE=STANDARD # STANDARD, BRIEFING, ANALYSIS, SILENT, VERBOSE
AEGIS_USER_NAME=User
AEGIS_LOG_LEVEL=INFO

# --- ANTIGRAVITY KIT 2.0 ---
ANTIGRAVITY_CPU_THRESHOLD=40.0
ANTIGRAVITY_RAM_THRESHOLD_GB=6.0
ANTIGRAVITY_TELEMETRY_LOG=.tmp/telemetry.log
